# SafeLock Telemetry — plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores reales:
#   cp .env.example .env

# Clave secreta para autenticación de la API y el dashboard
API_SECRET=openlock2026

# Credenciales de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Puerto del servidor (opcional, default 8000)
PORT=8000
